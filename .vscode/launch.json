{
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Project",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/haproxy",
                "args": [ "-f ./haproxy.conf" ],
                "stopAtEntry": false,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": false,
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ],
                "preLaunchTask": "Build Project",
                "miDebuggerPath": "/usr/bin/gdb",
                "miDebuggerArgs": "",
                "stopAtConnect": false
            }
        ]
    }
    